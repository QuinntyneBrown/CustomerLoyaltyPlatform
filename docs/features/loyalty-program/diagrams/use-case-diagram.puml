@startuml Loyalty Program Use Case Diagram

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor White
    BorderColor Black
}

left to right direction

actor "Business Owner" as Owner
actor "Manager" as Manager
actor "System" as System

rectangle "Loyalty Program Configuration" {

    usecase "Create Loyalty Program" as UC1
    usecase "Update Program Settings" as UC2
    usecase "Configure Earning Rules" as UC3
    usecase "Modify Earning Rules" as UC4
    usecase "Deactivate Earning Rules" as UC5
    usecase "Configure Redemption Rules" as UC6
    usecase "Modify Redemption Rules" as UC7
    usecase "Deactivate Redemption Rules" as UC8
    usecase "Set Expiration Policy" as UC9
    usecase "Configure Tier Structure" as UC10
    usecase "Preview Points Calculator" as UC11
    usecase "View Program Analytics" as UC12

    usecase "Validate Rule Conflicts" as UC_VALIDATE
    usecase "Calculate Sample Earnings" as UC_CALC
}

' Owner relationships
Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC4
Owner --> UC5
Owner --> UC6
Owner --> UC7
Owner --> UC8
Owner --> UC9
Owner --> UC10
Owner --> UC11
Owner --> UC12

' Manager relationships
Manager --> UC2
Manager --> UC3
Manager --> UC4
Manager --> UC6
Manager --> UC7
Manager --> UC11
Manager --> UC12

' System relationships
System --> UC_VALIDATE
System --> UC_CALC

' Includes
UC3 ..> UC_VALIDATE : <<include>>
UC4 ..> UC_VALIDATE : <<include>>
UC11 ..> UC_CALC : <<include>>

note right of UC10
    Optional feature.
    Requires tiered
    program type.
end note

note right of UC9
    Affects all future
    point earnings.
    Existing points
    use old policy.
end note

@enduml
